{
  "scripts": {
    "dokku": {
      "predeploy": "python manage.py migrate --noinput",
      "postdeploy": "python manage.py collectstatic --noinput"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "standard-1x"
    }
  },
  "checks": {
    "web": [
      {
        "type": "http",
        "port": 5000,
        "path": "/",
        "attempts": 3,
        "timeout": 5,
        "grace": 10,
        "headers": {
          "Host": "malvabeauty.duckdns.org"
        }
      }
    ]
  }
}